AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Database Configuration
# Leave blank for default local SQLite (sqlite:///./cloudsentinel.db)
# Or configure PostgreSQL: postgresql://username:password@localhost:5432/cloudsentinel
# Note: percent-encode special characters in username/password (e.g. quote_plus)
DATABASE_URL=

# Masooma: AI Analysis Engine (Groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Security & Authentication Configuration
# 1. Server-to-Server API Key (External CI/CD and automated runners only)
# Never exposed to web browsers or frontend bundles.
CLOUDSENTINEL_API_KEY=
CLOUDSENTINEL_ACTOR_NAME=cloudsentinel_operator

# 2. Browser UI Session Authentication (Demo Identity Provider)
# Controls the credentials accepted at POST /auth/login for local demo use.
# Session authentication uses HttpOnly cookies + Double-Submit CSRF tokens.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=SentinelAdmin2026!
SESSION_TTL_SECONDS=43200

